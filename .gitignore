# Secrets — never commit
.env
*.env
ANTHROPIC_API_KEY*

# Managed Agents local state (per-user, regenerated by setup scripts)
.specialist_ids.json
.coordinator_id
.environment_id
.last_session_id
.agentrx_*_id
.agentrx_*_ids.json
.skills_attached
.skill_ids.json

# AgentRx sandbox — a disposable copy of the Meridian exercise, regenerated
# by `python agentrx.py reset`. Not source, and runs.jsonl carries real cost
# figures from this machine's own runs.
# Glob, not an enumeration. The list used to name sandbox/ and sandbox_test/
# explicitly and silently missed sandbox_notebook/ - which would have
# published the whole workshop exercise (its prompts, tool specs, traces and
# PDFs) into a PUBLIC fork.
agentrx/sandbox*/
agentrx/artifacts/
agentrx/artifacts_best/

# Run logs: local absolute paths, per-run cost figures, and full harness
# transcripts. Useful locally, not source.
agentrx/*.log

# outputs from run_deal_desk.py / run_diagnosis.py
outputs/

__pycache__/
*.pyc
.ipynb_checkpoints/

# per-sandbox run locks
agentrx/.run.*.lock

# Executed notebook carries this machine's absolute paths in its cell outputs.
agentrx/AgentRx_Tests_executed.ipynb
